root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,ts,jsx,tsx,json,css,scss,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py}]
indent_style = space
indent_size = 4

[*.{rs}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.{sh,bash}] 
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.ini]
indent_style = space
indent_size = 2
